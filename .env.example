# ===== 企业微信群机器人配置 =====
# Webhook URL，多个用逗号分隔
# 获取方式：企业微信群 → 右键 → 添加群机器人 → 复制 Webhook 地址
WECHAT_WEBHOOKS=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your_key_here

# ===== AI 模型配置 (智谱 GLM-4-Flash 免费模型) =====
# 智谱AI API Key，到 https://open.bigmodel.cn/ 申请
GLM_API_KEY=your_glm_api_key_here
GLM_MODEL=glm-4-flash
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ===== 定时任务配置 (北京时间) =====
# A股收盘推送：仅交易日执行
A_STOCK_PUSH_TIME=15:05
# 美股隔夜行情推送：每天执行
US_STOCK_PUSH_TIME=10:00

# ===== 股市数据接口 =====
SINA_HQ_URL=https://hq.sinajs.cn
